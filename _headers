/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), geolocation=(), microphone=()
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; script-src 'self'; style-src 'self'; font-src 'self'; connect-src 'self' https://api.dictivo.app; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests

/assets/*
  Cache-Control: public, max-age=300, must-revalidate

# Pages applies every matching rule in file order and joins a header set twice with a comma.
# These files never change in place, so their rules come after /assets/* and detach its
# Cache-Control ("! ") before setting their own.
/assets/ui/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/assets/favicon.svg
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/assets/fonts/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

# site.css and site.js as renamed with their content hash by inject-asset-version.mjs.
/assets/site.:hash.css
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/assets/site.:hash.js
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/downloads.json
  Cache-Control: public, max-age=300
  X-Robots-Tag: noindex

/download/*
  Cache-Control: no-store

/404.html
  Cache-Control: no-store
  X-Robots-Tag: noindex

/data/*
  Cache-Control: no-store
  X-Robots-Tag: noindex

/scripts/*
  Cache-Control: no-store
  X-Robots-Tag: noindex

/tmp/*
  Cache-Control: no-store
  X-Robots-Tag: noindex

/README.md
  Cache-Control: no-store
  X-Robots-Tag: noindex

/wrangler.toml
  Cache-Control: no-store
  X-Robots-Tag: noindex

/assets/evidence/*
  X-Robots-Tag: noindex
